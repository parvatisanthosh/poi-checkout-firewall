{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "prisma/schema.prisma"],
  "globalPassThroughEnv": ["*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {},
    "test": {
      "env": ["RUN_DB_TESTS", "RUN_LLM_TESTS", "REDIS_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "mock": {
      "cache": false,
      "persistent": true
    }
  }
}
