{
  "name": "poi-checkout-firewall",
  "version": "0.0.0",
  "private": true,
  "description": "ProofOfIntent -- Semantic Checkout Firewall for AI shopping agents on PayPal",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:mock": "turbo run dev mock --filter=!@poi/api",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "mock:api": "pnpm --filter @poi/shared mock",
    "keys:gen": "node scripts/keys-gen.mjs",
    "paypal:smoke": "pnpm --filter @poi/api paypal:smoke",
    "db:up": "docker compose up -d"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
