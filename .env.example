# ProofOfIntent -- copy to .env and fill in. NEVER commit .env.
# Owners: api = Parvati (apps/api), web/bazaar/agent/bench = teammate. See docs/CONTRACTS.md.

# --- Infra (api) ------------------------------------------------------------
DATABASE_URL=postgresql://poi:poi@localhost:5432/poi
# Host port for docker compose Postgres. Change both this and DATABASE_URL if 5432 is taken
# (e.g. by a native Postgres install).
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379
API_PORT=4000
# CORS origin for the API, and PayPal return/cancel base URL for the Bazaar
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# BullMQ verify-worker concurrency
VERIFY_CONCURRENCY=4
# true: the API process also runs the verify worker. false: run `node apps/api/dist/worker.js` separately
WORKER_INLINE=true

# --- PayPal sandbox (api, bazaar) -------------------------------------------
# One shared sandbox REST app ("poi-bazaar"); credentials from developer.paypal.com > Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# From the sandbox app's webhook settings (api)
PAYPAL_WEBHOOK_ID=
# Same client id, public (web, PayPal JS SDK)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- LLM providers (api, agent) -- the defaults below need only the two FREE keys:
#   Google AI Studio (aistudio.google.com/apikey) and Groq (console.groq.com/keys).
#   OpenAI / Anthropic are optional (paid).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# Model ids are "provider:model". Examples only -- check each provider's current list
# and pick cheap, fast models; the benchmark makes a few hundred calls.
# Intent compiler (api)
COMPILER_MODEL=google:gemini-flash-lite-latest
# Semantic judge (api) -- keep it different from the agent model where possible
JUDGE_MODEL=google:gemini-flash-lite-latest
# Terms RAG embeddings (api) -- 1536 dims (Gemini is asked for 1536; OpenAI text-embedding-3-small is 1536)
EMBEDDING_MODEL=google:gemini-embedding-001
# Shopping-agent models (web, bench), comma list
AGENT_MODELS=google:gemini-flash-lite-latest,groq:openai/gpt-oss-120b

# --- Signing (api) ----------------------------------------------------------
# Ed25519 private JWK (JSON on one line). Generate with: pnpm keys:gen
POI_SIGNING_JWK=

# --- Service URLs (web, bench, mcp, bazaar) ---------------------------------
POI_API_URL=http://localhost:4000
BAZAAR_URL=http://localhost:4100
BAZAAR_PORT=4100
# Public API URL for Socket.IO + fetches from the browser (web)
NEXT_PUBLIC_POI_API_URL=http://localhost:4000
# Bazaar URL as seen from the browser (storefront page)
NEXT_PUBLIC_BAZAAR_URL=http://localhost:4100

# --- Tests ------------------------------------------------------------------
# Set to 1 to run tests that call real LLMs (skipped in CI)
RUN_LLM_TESTS=

# --- Optional: Elastic terms search stretch (api) ---------------------------
ELASTIC_URL=
ELASTIC_API_KEY=

# --- Layer 2: arena, immune memory, calibration (api) -- docs/CONTRACTS-L2.md 4.8 -------------
# Attacker engine: real = @poi/arena (LLM attacker), fake = no-LLM stand-in for demos/offline
ARENA_ENGINE=real
# Attacker A (train) and B (held-out only) must come from different model vendors.
ARENA_ATTACKER_MODEL=groq:openai/gpt-oss-120b
ARENA_HELDOUT_ATTACKER_MODEL=groq:qwen/qwen3.8-27b
# The agent under attack (Layer 1 agent default)
ARENA_AGENT_MODEL=google:gemini-flash-lite-latest
# Trial parallelism (use 1-2 on free-tier keys) and a hard spend stop per run
ARENA_CONCURRENCY=4
ARENA_MAX_USD=15
# Optional price overrides for the budget guard (USD per 1M tokens), e.g. {"groq:openai/gpt-oss-120b":{"in":0.15,"out":0.6}}
ARENA_PRICES=
# Immune memory: MinHash Jaccard and embedding cosine match thresholds; promotion gate set
IMMUNE_JACCARD=0.5
IMMUNE_COSINE=0.85
IMMUNE_BENIGN_SET=bench/evolved/benign-40.json
# Merchant risk above this -> ASK_HUMAN
RISK_ASK_THRESHOLD=0.35
# Conformal gate: default alpha, and the benign quantile that sets lambdaVoid
CRC_ALPHA=0.05
CRC_BENIGN_VOID_QUANTILE=0.99
