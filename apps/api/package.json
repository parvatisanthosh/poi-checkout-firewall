{
  "name": "@poi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev:arena-worker": "tsx watch src/arena-worker.ts",
    "start:arena-worker": "node dist/arena-worker.js",
    "calibrate": "tsx src/calibrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "paypal:smoke": "tsx scripts/paypal-smoke.ts",
    "terms:ingest": "tsx scripts/ingest-terms.ts"
  },
  "dependencies": {
    "@paypal/agent-toolkit": "1.11.0",
    "@poi/agent": "workspace:*",
    "@poi/arena": "workspace:*",
    "@poi/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "ai": "^7.0.165",
    "bullmq": "^6.7.2",
    "canonicalize": "^5.1.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "tsup": "^9.0.0"
  }
}
