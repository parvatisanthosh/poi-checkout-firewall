{
  "name": "@poi/bazaar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --platform node --target node20 --clean --no-external @poi/shared",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@poi/shared": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "tsup": "^9.0.0"
  }
}
